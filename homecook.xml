<?xml version="1.0"?>
<Container version="2">
  <Name>HomeCook</Name>
  <Repository>ghcr.io/mjy378283319/homecook:latest</Repository>
  <Registry>https://github.com/mjy378283319/homecook/pkgs/container/homecook</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/mjy378283319/homecook/issues</Support>
  <Project>https://github.com/mjy378283319/homecook</Project>
  <WebUI>http://[IP]:[PORT:9926]</WebUI>
  <Icon>https://raw.githubusercontent.com/mjy378283319/homecook/main/static/icon.png</Icon>
  <Description>家常菜单 HomeCook：面向中式家庭饮食的菜谱 / 食材库 / 采购清单 / 周菜单管理应用</Description>
  <Category>Tools: Utilities:</Category>
  <Beta>false</Beta>
  <Overview>面向中式家庭饮食的菜单管理应用（Mealie 的本地化替代）。
· 菜谱：菜系 / 做法 / 难度 / 人份 / 口味标签 / 小贴士，食材按斤两克计量
· 封面图：列表缩略图 + 详情大图，支持上传或粘链接，下厨房导入自动抓图
· 营养：11 项指标（卡路里/碳水/胆固醇/脂肪/纤维/蛋白质/饱和脂肪/钠/糖/反式脂肪/不饱和脂肪），按食材每 100g 自动估算，可切每份/全锅或手动填
· 食材库：中式分类树，记录每 100g 营养、单件克重、采购规格与常去渠道（菜市场 / 超市 / 电商）
· 采购清单：从勾选菜谱或周菜单一键聚合，自动合并同种食材并按斤两换算
· 周菜单：一周早 / 午 / 晚排菜，按区间生成采购清单
· 导入：粘贴下厨房链接解析菜谱，导入前可复核编辑
默认账号 admin / homecook，首次部署请修改密码与会话密钥。</Overview>
  <Screenshot>https://raw.githubusercontent.com/mjy378283319/homecook/main/static/screenshots/recipes.png</Screenshot>
  <Screenshot>https://raw.githubusercontent.com/mjy378283319/homecook/main/static/screenshots/recipe-detail.png</Screenshot>
  <Screenshot>https://raw.githubusercontent.com/mjy378283319/homecook/main/static/screenshots/nutrition-detail.png</Screenshot>
  <Screenshot>https://raw.githubusercontent.com/mjy378283319/homecook/main/static/screenshots/shopping-list.png</Screenshot>
  <Screenshot>https://raw.githubusercontent.com/mjy378283319/homecook/main/static/screenshots/mealplan.png</Screenshot>
  <Config Name="WebUI 端口" Target="8000" Default="9926" Mode="tcp" Description="浏览器访问端口，容器内部固定 8000" Type="Port" Display="always" Required="true" Mask="false">9926</Config>
  <Config Name="数据目录" Target="/data" Default="/mnt/user/appdata/homecook" Mode="rw" Description="SQLite 数据库与封面图持久化目录，务必备份" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/homecook</Config>
  <Config Name="登录用户名" Target="WEB_USER" Default="admin" Mode="" Description="Web 登录账号" Type="Variable" Display="always" Required="true" Mask="false">admin</Config>
  <Config Name="登录密码" Target="WEB_PASSWORD" Default="changeme" Mode="" Description="Web 登录密码，务必改成强密码" Type="Variable" Display="always" Required="true" Mask="true">changeme</Config>
  <Config Name="会话密钥" Target="SECRET_KEY" Default="" Mode="" Description="Cookie 签名密钥，务必改成随机串：openssl rand -hex 32" Type="Variable" Display="always" Required="true" Mask="true">please-change-to-a-random-string</Config>
  <Config Name="时区" Target="TZ" Default="Asia/Shanghai" Mode="" Description="容器时区" Type="Variable" Display="always" Required="false" Mask="false">Asia/Shanghai</Config>
</Container>
